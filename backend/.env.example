PORT=3001
# Set HOST=0.0.0.0 only when a Prometheus container needs to scrape this API.
HOST=127.0.0.1
FRONTEND_ORIGIN=http://localhost:5173
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
TAVILY_API_KEY=
# Optional: send local 5xx error metadata to an authenticated OpenClaw Gateway hook.
# Failed request and response bodies are credential-redacted and size-limited before sending to OpenClaw.
OPENCLAW_ERROR_HOOK_URL=
OPENCLAW_ERROR_HOOK_TOKEN=
OPENCLAW_ERROR_AGENT_ID=nxtgen-error-reviewer
# Optional: defaults to ../frontend/public/reports from the backend workspace.
REPORTS_DIR=
